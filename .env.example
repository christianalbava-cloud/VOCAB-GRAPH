# VocabGraph — Auth Configuration Template
# Copy this file to .env and fill in real values.
# Generate the password hashes by running:   python setup_auth.py

JWT_SECRET=<run setup_auth.py to generate>
JWT_EXPIRE_HOURS=8

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<bcrypt hash — generated by setup_auth.py>

VISITOR_USERNAME=visitor
VISITOR_PASSWORD_HASH=<bcrypt hash — generated by setup_auth.py>

# LLM provider (unchanged from before)
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
